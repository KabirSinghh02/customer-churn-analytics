## 🗂️ SQL Query Samples

```sql
-- 1. Feature Engineering SQL View with Tenure Buckets & Stickiness Score
CREATE OR REPLACE VIEW v_Telecom_Churn_Final AS
SELECT 
    *,
    CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END AS Churn_Entry,
    CASE 
        WHEN tenure < 12 THEN '0-1 Year'
        WHEN tenure <= 24 THEN '1-2 Years'
        WHEN tenure <= 48 THEN '2-4 Years'
        ELSE 'Over 4 Years'
    END AS Tenure_Group,
    (CASE WHEN PhoneService = 'Yes' THEN 1 ELSE 0 END +
     CASE WHEN InternetService != 'No' THEN 1 ELSE 0 END +
     CASE WHEN OnlineSecurity = 'Yes' THEN 1 ELSE 0 END +
     CASE WHEN TechSupport = 'Yes' THEN 1 ELSE 0 END) AS Service_Score
FROM churn_data;

-- 2. Churn Rate Percentage by Payment Method
SELECT 
    PaymentMethod,
    COUNT(*) AS Total_Customers,
    SUM(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) AS Churned_Count,
    ROUND(AVG(CASE WHEN Churn = 'Yes' THEN 1 ELSE 0 END) * 100, 2) AS Churn_Rate_Percentage
FROM churn_data
GROUP BY PaymentMethod
ORDER BY Churn_Rate_Percentage DESC;
